# Strava API credentials
# Get these from: https://www.strava.com/settings/api

# Your Strava API app's Client ID
STRAVA_CLIENT_ID=your_client_id_here

# Your Strava API app's Client Secret
STRAVA_CLIENT_SECRET=your_client_secret_here

# Your Strava refresh token (obtained via OAuth2 authorization flow)
STRAVA_REFRESH_TOKEN=your_refresh_token_here

# --- HTTP transport (optional, personal remote use) ---
# Required when running with --transport http. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# STRAVA_MCP_AUTH_TOKEN=your_long_random_token_here
